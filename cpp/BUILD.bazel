load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

genrule(
    name = "codegen_cpp",
    srcs = ["//core/ffi/diplomat:src/lib.rs"],
    outs = [
        "BaseUnits.d.hpp",
        "BaseUnits.hpp",
        "DvError.d.hpp",
        "DvError.hpp",
        "DimensionalVariable.d.hpp",
        "DimensionalVariable.hpp",
        "diplomat_runtime.hpp",
    ],
    tools = ["//tools/diplomat_codegen:diplomat_codegen"],
    cmd = "$(location //tools/diplomat_codegen:diplomat_codegen) cpp $(RULEDIR) --entry $(location //core/ffi/diplomat:src/lib.rs)",
)

filegroup(
    name = "generated_headers",
    srcs = [":codegen_cpp"],
)

cc_library(
    name = "generated_cpp_headers",
    hdrs = [":generated_headers"],
    includes = ["."],
)

alias(
    name = "dv_headers",
    actual = ":dv_cpp",
)

alias(
    name = "dv_c",
    actual = "//c:dv_c",
)

cc_library(
    name = "dv_generated",
    hdrs = [":generated_headers"],
    includes = ["."],
    deps = [
        ":generated_cpp_headers",
        "//core/ffi/diplomat:dv_diplomat_capi_static",
    ],
)

cc_library(
    name = "dv_cpp",
    hdrs = ["include/dv.hpp"],
    includes = ["include"],
    deps = [":dv_generated"],
)
